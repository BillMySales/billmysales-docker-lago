# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only), tools
# (console).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=lago

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=billing.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of Lago: the app (<url>/), the REST API
# (<url>/api/v1) and file downloads. Applied on every `up`.
LAGO_URL=https://billing.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=billing.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED). Keep a copy of them outside the server:
# the database's encrypted fields can't be read without the three
# LAGO_ENCRYPTION_* values, also when restoring a backup.
# ---------------------------------------------------------------------------
# openssl rand -hex 64
SECRET_KEY_BASE=
# openssl rand -hex 32 (each)
LAGO_ENCRYPTION_PRIMARY_KEY=
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
DB_PASSWORD=
# Admin user, created if no user with that email exists (changing it later
# adds another one); its password is set only then.
LAGO_ADMIN_EMAIL=
LAGO_ADMIN_PASSWORD=
# Optional fixed API key (Authorization: Bearer <key>), added to the
# organization's keys; Lago always generates one too (Developers > API keys).
#LAGO_API_KEY=
#DB_USER=lago
#DB_NAME=lago

# ---------------------------------------------------------------------------
# Organization (initial settings, applied only on the first install; later
# changes in the app are kept)
# ---------------------------------------------------------------------------
#LAGO_ORG_NAME=Lago
#LAGO_COUNTRY=CL
#LAGO_CURRENCY=CLP
#LAGO_CITY=Santiago
# Language of invoices and credit notes (en, es, fr, de, it, nb, sv, pt-BR,
# zh-TW).
#LAGO_DOCUMENT_LOCALE=es
# Tax applied to the organization by default (%); empty = none.
#LAGO_TAX_RATE=19
#LAGO_TAX_NAME=IVA

# ---------------------------------------------------------------------------
# Premium edition and telemetry
# ---------------------------------------------------------------------------
# Lago premium license key (timezones, invoice emails, ...); empty = free
# edition.
#LAGO_LICENSE=
# Usage data sent to Segment.
#LAGO_DISABLE_SEGMENT=true
# true = no PDFs (invoices, credit notes).
#LAGO_DISABLE_PDF_GENERATION=false

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Lago API and front images (the same version). After changing it,
# `docker compose up -d` pulls the images and `setup` migrates. Back up first.
#LAGO_VERSION=v1.53.0
#GOTENBERG_VERSION=8.15
# PostgreSQL major version and pg_partman release of the database image
# (image/postgres, built locally: `up -d` builds it when its tag changes;
# `docker compose build --pull db` for PostgreSQL patch releases). A new
# POSTGRES_VERSION major needs a dump and restore. Set PARTMAN_SHA256 to the
# new release archive's SHA-256 (empty: not checked).
#POSTGRES_VERSION=15
#PARTMAN_VERSION=5.4.3
#PARTMAN_SHA256=c52e3b8cf80d306468f48fbdb1905e4c2574bf8362240af57aebbbf9e18c6fe2
#POSTGRES_IMAGE=lago-postgres
#REDIS_VERSION=7.4
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31
# Mailpit's web UI (development only).
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Mail (SMTP, recommended): password resets and invitations (invoice emails
# are a premium feature). STARTTLS when the server offers it; SMTPS (port 465)
# is not supported by Lago. Without SMTP_HOST no emails are sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address.
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Processes, resources and logs
# ---------------------------------------------------------------------------
# User ID the Lago containers run as (the image has no user of its own).
#LAGO_UID=1000
# Puma processes and threads of the API; Sidekiq threads of the worker.
#WEB_CONCURRENCY=1
#RAILS_MAX_THREADS=5
#SIDEKIQ_CONCURRENCY=10
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#REDIS_MEMORY_LIMIT=256m
#SETUP_MEMORY_LIMIT=1g
#API_MEMORY_LIMIT=1g
#WORKER_MEMORY_LIMIT=1g
#CLOCK_MEMORY_LIMIT=768m
#FRONT_MEMORY_LIMIT=128m
#PDF_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#CONSOLE_MEMORY_LIMIT=1g
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
