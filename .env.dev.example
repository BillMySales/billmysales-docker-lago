# Development environment: cp .env.dev.example .env && docker compose up -d --build
# Public example values: never use them on a server (see .env.prod.example).
COMPOSE_PROFILES=mailpit

LAGO_URL=http://localhost:8114
SITE_ADDRESS=:80
HTTP_PORT=8114
HTTPS_PORT=8414
MAILPIT_PORT=8025

SECRET_KEY_BASE=dev-secret-key-base-dev-secret-key-base-dev-secret-key-base-0000
LAGO_ENCRYPTION_PRIMARY_KEY=dev-encryption-primary-key-00000
LAGO_ENCRYPTION_DETERMINISTIC_KEY=dev-encryption-deterministic-key
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=dev-encryption-derivation-salt-0
DB_PASSWORD=lago
LAGO_ORG_NAME=Empresa
LAGO_ADMIN_EMAIL=admin@example.com
LAGO_ADMIN_PASSWORD=admin12345
# Fixed API key (Authorization: Bearer <key>) for local integrations.
LAGO_API_KEY=dev-api-key

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=billing@example.com
